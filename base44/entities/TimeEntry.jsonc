{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "employee_email": {
      "type": "string",
      "description": "אימייל העובד (למנהלים - לבחירת עובד)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "תאריך העבודה"
    },
    "start_time": {
      "type": "string",
      "description": "שעת התחלה"
    },
    "end_time": {
      "type": "string",
      "description": "שעת סיום"
    },
    "break_minutes": {
      "type": "number",
      "default": 0,
      "description": "הפסקה בדקות"
    },
    "notes": {
      "type": "string",
      "description": "הערות"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "סטטוס אישור"
    },
    "total_hours": {
      "type": "number",
      "description": "סה״כ שעות עבודה"
    }
  },
  "required": [
    "employee_email",
    "date",
    "start_time",
    "end_time"
  ],
  "rls": {
    "update": {
      "$or": [
        {
          "data.status": "pending"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.status": "pending"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}