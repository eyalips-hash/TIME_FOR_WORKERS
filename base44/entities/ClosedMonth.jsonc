{
  "name": "ClosedMonth",
  "type": "object",
  "properties": {
    "employee": {
      "type": "string",
      "description": "אימייל העובד"
    },
    "month": {
      "type": "number",
      "description": "חודש (0-11)"
    },
    "year": {
      "type": "number",
      "description": "שנה"
    },
    "total_hours": {
      "type": "number",
      "description": "סה״כ שעות מאושרות"
    },
    "closed_by": {
      "type": "string",
      "description": "מי סגר את החודש"
    },
    "closed_date": {
      "type": "string",
      "format": "date-time",
      "description": "תאריך סגירת החודש"
    }
  },
  "required": [
    "employee",
    "month",
    "year"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}